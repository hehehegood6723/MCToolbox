# 统一换行符，避免 Windows / macOS 贡献者互相改到整行
* text=auto

# 源码用 LF
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不要被当成文本处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.zip  binary
*.exe  binary
*.jar  binary
