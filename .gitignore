# ---- 依赖 ----
node_modules/

# ---- 构建产物（体积很大，绝对不要提交）----
dist/
build/
out/
*.exe

# ---- 压缩包 ----
*.zip
*.7z
*.rar

# ---- 本地配置（可能含你的 CurseForge Key / 微软登录令牌）----
mctool-config.json
mctool-account.json

# ---- 日志与临时文件 ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tmp
*.bak

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 运行期产物 ----
# 注意：前面加 / 表示只匹配仓库根目录，
# 否则会把 renderer/assets/（托盘图标、捐款二维码）一起忽略掉。
/versions/
/libraries/
/assets/
/saves/
/crash-reports/
/logs/
